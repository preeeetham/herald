#!/usr/bin/env bash
# Blocks a push if any commit being pushed contains a secret (gitleaks).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed (brew install gitleaks). Push blocked." >&2
  exit 1
fi

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"               # new branch: only unpushed commits
  else
    range="$remote_sha..$local_sha"
  fi
  echo "pre-push: scanning $range for secrets…"
  gitleaks git --no-banner --redact --log-opts="$range" .
done
